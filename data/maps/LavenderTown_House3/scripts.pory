raw `
LavenderTown_House3_MapScripts::
	.byte 0
`

script LavenderTown_House3_girl {
    lock
	faceplayer
	msgbox("I'm studying hard with my grandma.\nI'm not affraid of GHOSTS.\pDo you have one with you?$")
	release
	end
}

script LavenderTown_House3_agatha {
    lock
	faceplayer
    if (flag(FLAG_BADGE12_GET) == true) {
        msgbox("It was nice to\nbattle with you.\pI see what the old duff sees in\nyou.\pI belive we will meet again\n in the Indigo Plateau.")
    } else {
        specialvar(VAR_RESULT, TrainerMetGhostGymPrereq)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("I belive POKéMON are for battling!\p What do you think?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == 1) {
                msgbox("Can you help me with my\ngranddaugther?$", MSGBOX_YESNO)
                if (var(VAR_RESULT) == 1) {
                    trainerbattle_enforce_set(TRAINER_AGATHA_GYMLEADER, "Let see what you can do!", format("Well done! I have a special gift for you."), LavenderTown_House3_afterbattle)
                }
            } else {
                msgbox(format("I don't know what the old duff sees in you."))
            }
        } else {
            msgbox("I had to put the GHOST GYM on hold.\pI can see your POKéMON are not at\nthe destined moment.\pNot as green as a TENTACOOL...\nNot as seasoned as a VENUSAUR.$")
        }
        
    }
	release
	end
}

script LavenderTown_House3_afterbattle {
    setflag(FLAG_BADGE12_GET)
    giveitem(ITEM_TM30)
    msgbox(format("You got the DARK SOUL BADGE"))
    msgbox(LavenderTown_House3_Text_ExplainTM)
    release
	end
}

text LavenderTown_House3_Text_ExplainTM {
    "TM30 contains SHADOW BALL.\nA sinister GHOST-type attack that\nmay lower SP. DEF."
}
