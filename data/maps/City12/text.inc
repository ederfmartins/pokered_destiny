City12_Lance_Text_0:
    .string "You found this place... Impressive.\p"
    .string "I am Lance, the Dragon Master.\p"
    .string "Want to test your mettle?$"

City12_Lance_Text_Intro:
    .string "Then let us begin.$"

City12_Lance_Text_Defeat:
    .string "Your spirit... it resonates with dragons.$"

City12_Lance_Text_PostBattle:
    .string "You have proven yourself.\p"
    .string "Take this badge as proof of your bond\n"
    .string "with the Dragon Heart.$"

City12_Lance_Text_Declined:
    .string "Return when you are ready.$"

City12_Text_ReturnSign::
    .string "Truck driver waves from his cab.\p"
    .string "Going back to the mainland?\n"
    .string "Want a ride?$"

City12_Text_ReturnSign_Warp:
    .string "Get in. We're leaving.$"

City12_Text_ReturnSign_Declined:
    .string "No rush.$"
