}

script Dark_city_yaz_gym_leader {
    lock
    faceplayer
    trainerbattle(TRAINER_BATTLE_SINGLE_ENFORCE_SET_MODE, TRAINER_YAZ_LEADER, 0, Dark_city_yaz_gym_leader_start, Dark_city_yaz_gym_leader_end)
    closemessage
    msgbox(Dark_city_yaz_gym_leader_after)
    releaseall
    end
}

text Dark_city_yaz_gym_leader_start {
    "This gym is only for the strongest."
}

text Dark_city_yaz_gym_leader_end {
    "Yas will never surrender!"
}

text Dark_city_yaz_gym_leader_after {
    "I lost. I will behave better and train harder."
}
