raw `
Dark_city_yaz_gym_MapScripts::
	.byte 0
`

script Dark_city_yaz_gym_man1 {
    lock
    faceplayer
    trainerbattle(TRAINER_BATTLE_SINGLE, TRAINER_YAZ_MAN1, 0, Dark_city_yaz_gym_man1_start, Dark_city_yaz_gym_man1_end)
    closemessage
    msgbox(Dark_city_yaz_gym_man1_after)
    releaseall
    end
}

text Dark_city_yaz_gym_man1_start {
    "This is my martial style!"
}

text Dark_city_yaz_gym_man1_end {
    "Our boss will have a superior fight style!"
}

text Dark_city_yaz_gym_man1_after {
    "I lost. I will behave better next time."
}

script Dark_city_yaz_gym_man2 {
