City12_House1_Text_Intro::
    .string "I'm the trucker's wife. I traveled\n"
    .string "every route with my husband, so I\n"
    .string "know a thing or two about moves.\p"
    .string "Want me to help your Pokémon\n"
    .string "remember moves they've forgotten?$"

City12_House1_Text_WhichMon::
    .string "Which Pokémon should I help?$"

City12_House1_Text_Done::
    .string "There! Your Pokémon can remember\n"
    .string "that move again.$"

City12_House1_Text_Declined::
    .string "Come back if you change your mind.$"

City12_House1_Text_Egg::
    .string "I can't help an Egg remember a move.$"

City12_House1_Text_NoMoves::
    .string "That Pokémon doesn't have any\n"
    .string "forgotten moves it can remember.$"
